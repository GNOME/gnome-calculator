#: data/org.gnome.calculator.gschema.xml:32
msgid "Persistent history tape"
msgstr "Davamlı tarixçə lenti"

#: data/org.gnome.calculator.gschema.xml:33
msgid ""
"History entries saved across sessions as (equation, answer) pairs. Written "
"on window close. Cleared when the user clears history."
msgstr ""
"Oturumlarda (tənlik, cavab) cütləri kimi yadda saxlanılan tarixçə "
"daxiletmələri. Qapalı pəncərəyə yazılıb. İstifadəçi tarixçəni təmizlədikdə "
"silinir."

#: data/org.gnome.calculator.gschema.xml:41
msgid "Accuracy value"
msgstr "Dəqiqlik dəyəri"

#: data/org.gnome.calculator.gschema.xml:42
msgid "The number of digits displayed after the numeric point"
msgstr "Nöqtədən sonra göstərilən rəqəmlərin sayı"

#: data/org.gnome.calculator.gschema.xml:47
msgid "Word size"
msgstr "Söz ölçüsü"

#: data/org.gnome.calculator.gschema.xml:48
msgid "The size of the words used in bitwise operations"
msgstr "Bitli əməliyyatlarda istifadə olunan sözlərin ölçüsü"

#: data/org.gnome.calculator.gschema.xml:53
msgid "Numeric base"
msgstr "Ədədi baza"

#: data/org.gnome.calculator.gschema.xml:54
msgid "The numeric base"
msgstr "Say sistemi bazası"

#: data/org.gnome.calculator.gschema.xml:58
msgid "Group digits"
msgstr "Rəqəmləri qruplaşdır"

#: data/org.gnome.calculator.gschema.xml:59
msgid "Indicates whether digits are grouped in large numbers."
msgstr ""
"Rəqəmlərin böyük ədədlərdə qruplaşdırılıb-qruplaşdırılmadığını göstərir."

#: data/org.gnome.calculator.gschema.xml:63
msgid "Show trailing zeroes"
msgstr "Sondakı sıfırları göstər"

#: data/org.gnome.calculator.gschema.xml:64
msgid ""
"Indicates whether any trailing zeroes after the numeric point should be "
"shown in the display value."
msgstr ""
"Nöqtədən sonrakı istənilən sıfırların ekranda göstərilib-göstərilməyəcəyini "
"bildirir."

#: data/org.gnome.calculator.gschema.xml:68
msgid "Number format"
msgstr "Ədəd formatı"

#: data/org.gnome.calculator.gschema.xml:69
msgid "The format to display numbers in"
msgstr "Ədədlərin göstəriləcəyi format"

#: data/org.gnome.calculator.gschema.xml:73
msgid "Angle units"
msgstr "Bucaq vahidləri"

#: data/org.gnome.calculator.gschema.xml:74
msgid "The angle units to use"
msgstr "İstifadə ediləcək bucaq vahidləri"

#: data/org.gnome.calculator.gschema.xml:78
msgid "Currency update interval"
msgstr "Valyuta yeniləmə intervalı"

#: data/org.gnome.calculator.gschema.xml:79
msgid ""
"How often the currency exchange rates should be updated. A value of 0 means "
"the currency exchange rates won't be fetched from the network at all."
msgstr ""
"Valyuta məzənnələrinin nə qədər tez-tez yenilənməli olduğu. 0 dəyəri valyuta "
"məzənnələrinin şəbəkədən ümumiyyətlə alınmayacağı deməkdir."

#: data/org.gnome.calculator.gschema.xml:83
msgid "Currency display"
msgstr "Valyuta görünüşü"

#: data/org.gnome.calculator.gschema.xml:84
msgid ""
"Indicates whether to show currency code, currency name or both of them in "
"the converter."
msgstr ""
"Çeviricidə valyuta kodunun, valyuta adının, yoxsa hər ikisinin "
"göstəriləcəyini müəyyən edir."

#: data/org.gnome.calculator.gschema.xml:88
msgid "Enabled completions"
msgstr "Aktivləşdirilmiş tamalamalar"

#: data/org.gnome.calculator.gschema.xml:89
msgid ""
"The types of completion proposals to be shown in the auto-completion list."
msgstr ""
"Avtotamamlama siyahısında göstəriləcək tamamlama təkliflərinin növləri."

#: data/org.gnome.calculator.gschema.xml:93
msgid "Favorite currencies"
msgstr "Sevimli valyutalar"

#: data/org.gnome.calculator.gschema.xml:94
msgid "The favorite currencies to be shown at the top of the currency list."
msgstr ""
"Valyuta siyahısının yuxarısında göstəriləcək sevimlilər sırasındakı "
"valyutalar."

